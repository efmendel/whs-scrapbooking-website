---
// Decorative, page-wide motion pieces. Nothing here carries content.
---
<div class="tape-progress" aria-hidden="true"><span class="tape-progress__fill" data-progress></span></div>

<svg class="stitch" aria-hidden="true" data-stitch>
  <defs>
    <mask id="stitch-reveal" maskUnits="userSpaceOnUse">
      <path data-stitch-mask fill="none" stroke="#fff" stroke-width="10" stroke-linecap="round" />
    </mask>
  </defs>
  <path data-stitch-line fill="none" stroke="var(--rose)" stroke-width="2.5" stroke-dasharray="11 9" stroke-linecap="round" mask="url(#stitch-reveal)" />
</svg>

<div class="sticker-layer" aria-hidden="true" data-sticker-layer></div>

<script>
  import '../scripts/motion';
  import '../scripts/cursor';
</script>

<style>
  .tape-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 12px;
    z-index: 50;
    pointer-events: none;
  }
  .tape-progress__fill {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0.92;
    background-color: var(--blush);
    background-image:
      linear-gradient(90deg, rgb(255 252 245 / 0.5) 50%, transparent 50%),
      linear-gradient(rgb(255 252 245 / 0.5) 50%, transparent 50%);
    background-size: 12px 12px;
    clip-path: polygon(0 0, 100% 0, 99.6% 50%, 100% 100%, 0 100%);
  }

  .stitch {
    position: absolute;
    top: 0;
    left: 0;
    width: 90px;
    height: 100%;
    z-index: 4;
    pointer-events: none;
    display: none;
  }
  @media (min-width: 1180px) {
    .stitch { display: block; }
  }

  .sticker-layer {
    position: absolute;
    inset: 0;
    z-index: 30;
    pointer-events: none;
    overflow: hidden;
  }
  .sticker-layer :global(svg) {
    position: absolute;
    filter: var(--shadow-sticker);
  }

  @media (prefers-reduced-motion: reduce) {
    .tape-progress { display: none; }
  }
</style>
