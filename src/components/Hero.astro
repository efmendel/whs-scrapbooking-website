---
import club from '../data/club.json';
import TornLabel from './TornLabel.astro';
import Polaroid from './Polaroid.astro';
import Stamp from './Stamp.astro';
import Sticker from './Sticker.astro';

const [p1, p2, p3] = club.heroPhotos;
---
<section class="hero wrap" id="top">
  <div class="hero__copy">
    <TornLabel color="butter" font="hand" tilt={-3} hero>welcome to the</TornLabel>

    <h1 class="hero__title display">
      <span class="visually-hidden">{club.clubName}: </span>
      <span class="hero__line" data-hero="line">Cut it.</span>
      <span class="hero__line" data-hero="line">Stick it.</span>
      <span class="hero__line" data-hero="line">Keep it.</span>
      <svg class="hero__squiggle" viewBox="0 0 340 24" fill="none" aria-hidden="true">
        <path
          data-squiggle
          d="M4 14 q13 -14 26 0 t26 0 t26 0 t26 0 t26 0 t26 0 t26 0 t26 0 t26 0 t26 0 t26 0 t26 0"
          stroke="var(--rose)" stroke-width="5" stroke-linecap="round"
        />
      </svg>
    </h1>

    <p class="hero__lede" data-hero="copy">
      {club.schoolName}’s scrapbooking club: a calm, creative corner where we turn memories into pages and
      take a breather while we do it.
    </p>

    <div class="hero__actions" data-hero="copy">
      <a href="#join" class="btn">
        <span>Join the club</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a href="#join" class="hero__code">
        <span class="lbl">Classroom code</span>
        <span class="hero__code-value">{club.classroom.code}</span>
      </a>
    </div>
  </div>

  <div class="hero__collage">
    <Polaroid
      hero eager
      class="hc hc--1"
      image={p1.image} caption={p1.caption} placeholderLabel="club photo"
      fill="fill-stripes-pink" tilt={-6} tape="dots"
      tapeStyle="top: -14px; left: 50%; margin-left: -56px; width: 112px; rotate: 4deg;"
      sizes="(max-width: 960px) 40vw, 250px"
    />
    <Polaroid
      hero eager
      class="hc hc--2"
      image={p2.image} caption={p2.caption} placeholderLabel="club photo"
      fill="fill-dots-butter" tilt={5} tape="gingham"
      tapeStyle="top: -10px; right: -24px; width: 104px; rotate: 38deg;"
      sizes="(max-width: 960px) 38vw, 230px"
    />
    <Polaroid
      hero eager
      class="hc hc--3"
      image={p3.image} caption={p3.caption} placeholderLabel="club photo"
      fill="fill-stripes-apricot" tilt={2} tape="candy"
      tapeStyle="top: -12px; left: 50%; margin-left: -46px; width: 92px; rotate: -6deg;"
      sizes="(max-width: 960px) 40vw, 240px"
    />
    <Stamp hero class="hc hc--stamp" label={`est. ${club.established}`} />
    <Sticker hero kind="heart" rotate={12} class="hc hc--heart" />
    <Sticker hero kind="star" rotate={-10} class="hc hc--star" />
    <Sticker hero kind="sparkle" class="hc hc--sparkle" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 620px) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
    padding-top: 64px;
    padding-bottom: 80px;
    min-height: 740px;
  }
  .hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 26px;
  }
  .hero__title {
    position: relative;
    font-size: clamp(64px, 7.5vw, 108px);
    line-height: 0.95;
    padding-bottom: 6px;
  }
  .hero__line { display: block; }
  .hero__squiggle {
    position: absolute;
    left: 0;
    bottom: -24px;
    width: min(340px, 72%);
    height: auto;
  }
  .hero__lede {
    margin-top: 18px;
    max-width: 520px;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 6px;
  }
  .hero__code {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 18px;
    background: var(--card);
    border: 2px dashed var(--rose);
    border-radius: 10px;
    rotate: 1.5deg;
  }
  .hero__code .lbl { font-size: 11px; }
  .hero__code-value {
    font-family: var(--font-label);
    font-size: 22px;
    letter-spacing: 0.12em;
  }

  /* collage: every piece is positioned in % of a 560 x 660 board */
  .hero__collage {
    position: relative;
    justify-self: end;
    width: min(560px, 100%);
    aspect-ratio: 560 / 660;
    margin-top: -24px;
  }
  .hero__collage :global(.hc) { position: absolute; }
  .hero__collage :global(.hc--1) { left: 2%; top: 3%; width: 44.6%; }
  .hero__collage :global(.hc--2) { left: 53.5%; top: 13.6%; width: 41%; }
  .hero__collage :global(.hc--3) { left: 19.6%; top: 57.5%; width: 42.9%; }
  .hero__collage :global(.hc--stamp) { left: 71.4%; top: 63.6%; rotate: 9deg; }
  .hero__collage :global(.hc--heart) { left: 41%; top: -1.5%; width: 15%; height: auto; }
  .hero__collage :global(.hc--star) { left: 84%; top: 1.5%; width: 15.7%; height: auto; }
  .hero__collage :global(.hc--sparkle) { left: 7%; top: 53%; width: 12.9%; height: auto; }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 28px;
      padding-bottom: 48px;
      min-height: 0;
      gap: 32px;
    }
    .hero__actions { flex-direction: column; align-items: stretch; width: 100%; }
    .hero__code { flex-direction: row; justify-content: space-between; align-items: center; rotate: 0deg; }
    .hero__code-value { font-size: 20px; }
    .hero__collage { justify-self: center; margin-top: 0; }
    .hero__collage :global(.polaroid) { padding: 9px 9px 42px; }
    .hero__collage :global(.polaroid__caption) { font-size: 21px; bottom: 10px; }
    .hero__collage :global(.hc--stamp) { scale: 0.7; transform-origin: top left; left: 68%; }
  }
</style>
