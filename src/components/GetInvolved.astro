---
import club from '../data/club.json';
import TornLabel from './TornLabel.astro';

const { meetings, classroom, advisor } = club;
const steps = [
  {
    title: 'Join our Google Classroom',
    body: 'Enter the class code to get announcements and meeting reminders.',
    color: 'var(--blush)',
  },
  {
    title: 'Come to a meeting',
    body: `We meet ${meetings.days} at ${meetings.time} in Room ${meetings.room}.`,
    color: 'var(--butter)',
  },
  {
    title: 'Bring your memories',
    body: `Photos, ticket stubs, notes: anything you want to keep. ${club.suppliesNote}`,
    color: 'var(--apricot)',
  },
];
---
<section id="join" class="join wrap">
  <div class="join__steps">
    <TornLabel color="pink" tilt={-2}>get involved</TornLabel>
    <h2 class="section-title" data-rise>Joining takes three steps</h2>

    <ol class="steps" role="list">
      {steps.map((s, i) => (
        <li class="step" data-step>
          <span class="step__num display" style={`background: ${s.color}`} aria-hidden="true">
            <span class="step__digit">{i + 1}</span>
            <svg class="step__check" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path data-check d="M5 12.5l4.5 4.5L19 7" stroke="var(--cocoa)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <div class="step__text">
            <h3 class="display">{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <div class="join__card-area">
    <div class="code-card" data-codecard>
      <svg class="code-card__clip" width="40" height="106" viewBox="0 0 36 96" aria-hidden="true">
        <path d="M12 30 V78 a10 10 0 0 0 20 0 V14 a12 12 0 0 0 -24 0 V70 a6 6 0 0 0 12 0 V26" fill="none" stroke="var(--rose)" stroke-width="3.5" stroke-linecap="round" />
      </svg>
      <span class="lbl code-card__kicker">Google Classroom</span>
      <h3 class="display code-card__title">Our class code</h3>

      <div class="code-card__code-row">
        <div class="code-card__code" data-stamp>
          <span class="code-value">{classroom.code}</span>
          <span class="code-card__ink" data-ink aria-hidden="true"></span>
        </div>
        <button class="code-card__copy" type="button" data-copy={classroom.code}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>

      <a href={classroom.link} class="btn" target="_blank" rel="noopener">
        <span>Open Google Classroom</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
      </a>
      <p class="hand code-card__help">code not working? ask {advisor.name}</p>
    </div>

    <div class="ticket join__ticket" data-ticket>
      <div class="ticket__main">
        <span class="lbl" style="font-size: 11px">next meeting</span>
        <span class="display" style="font-size: 24px; line-height: 1">{meetings.nextDate}</span>
        <span class="lbl" style="font-size: 11px">{meetings.time} · room {meetings.room}</span>
      </div>
      <div class="ticket__stub">
        <span class="lbl">admit</span>
        <span class="ticket__punch" data-punch aria-hidden="true"></span>
        <span class="lbl">one</span>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (label) label.textContent = 'Copied!';
      } catch {
        if (label) label.textContent = 'Select & copy';
      }
      setTimeout(() => { if (label) label.textContent = 'Copy'; }, 2000);
    });
  });
</script>

<style>
  .join {
    padding-top: 40px;
    padding-bottom: 160px;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 80px;
    align-items: start;
  }
  .join__steps {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .steps {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 34px;
  }
  .step { display: flex; gap: 22px; align-items: flex-start; }
  .step__num {
    position: relative;
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--card), 0 4px 8px rgb(60 40 35 / 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
  }
  .step__check {
    position: absolute;
    right: -14px;
    top: -12px;
    width: 34px;
    height: 34px;
    opacity: 0;
  }
  .step__text { display: flex; flex-direction: column; gap: 6px; padding-top: 4px; }
  .step__text h3 { font-size: 28px; line-height: 1.1; }
  .step__text p { font-size: 18px; line-height: 1.55; }

  .join__card-area { position: relative; padding-top: 30px; }
  .code-card {
    position: relative;
    padding: 48px 44px 60px;
    background-color: var(--card);
    background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 35px, rgb(120 146 180 / 0.25) 35px, rgb(120 146 180 / 0.25) 36px);
    rotate: 1.5deg;
    box-shadow: 0 16px 32px -16px rgb(60 40 35 / 0.45);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .code-card__clip { position: absolute; top: -34px; right: 56px; }
  .code-card__kicker { font-size: 15px; }
  .code-card__title { font-size: 36px; line-height: 1.1; }
  .code-card__code-row { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; margin: 6px 0; }
  .code-card__code {
    position: relative;
    padding: 14px 24px;
    background: var(--butter);
    border: 2px dashed var(--rose);
    border-radius: 12px;
    /* Nunito keeps a lowercase l clearly different from a 1 (the typewriter font doesn't) */
    font-family: var(--font-code);
    font-weight: 800;
    font-size: clamp(34px, 3.8vw, 50px);
    letter-spacing: 0.1em;
    line-height: 1;
    user-select: all;
  }
  .code-card__ink {
    position: absolute;
    inset: -10px;
    border-radius: 40% 55% 45% 60%;
    background: radial-gradient(closest-side, rgb(212 111 135 / 0.22), transparent);
    opacity: 0;
    pointer-events: none;
  }
  .code-card__copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    background: var(--card);
    color: var(--cocoa);
    border: 2px solid var(--cocoa);
    border-radius: 10px;
    font: 700 15px var(--font-body);
  }
  .code-card__copy:hover { background: var(--blush); }
  .code-card__help { font-size: 24px; color: var(--rose); margin-top: 6px; }

  .join__ticket {
    position: absolute;
    right: -20px;
    bottom: -84px;
    rotate: -5deg;
  }

  @media (max-width: 960px) {
    .join { grid-template-columns: minmax(0, 1fr); gap: 48px; padding-top: 8px; padding-bottom: 96px; }
    .steps { gap: 24px; margin-top: 8px; }
    .step { gap: 16px; }
    .step__num { width: 46px; height: 46px; font-size: 24px; box-shadow: 0 0 0 3px var(--card), 0 3px 6px rgb(60 40 35 / 0.2); }
    .step__text h3 { font-size: 22px; line-height: 1.15; }
    .step__text p { font-size: 16px; line-height: 1.5; }
    .code-card { padding: 38px 24px 36px; rotate: 1deg; gap: 12px; }
    .code-card__clip { right: 32px; top: -28px; width: 32px; height: 86px; }
    .code-card__title { font-size: 28px; }
    .code-card .btn { align-self: stretch; padding: 0 16px; font-size: 17px; white-space: nowrap; }
    .code-card__help { font-size: 21px; }
    .join__ticket { position: relative; right: auto; bottom: auto; margin: 32px auto 0; rotate: -3deg; }
  }
</style>
