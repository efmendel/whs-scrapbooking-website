---
import club from '../data/club.json';
import TornLabel from './TornLabel.astro';
import Polaroid from './Polaroid.astro';

const looks = [
  { fill: 'fill-stripes-pink', tilt: -2, tape: 'dots', tapeTilt: 3, speed: 0.6 },
  { fill: 'fill-dots-butter', tilt: 1.5, tape: 'gingham', tapeTilt: -4, speed: 1.2 },
  { fill: 'fill-gingham-apricot', tilt: -1, tape: 'dots', tapeTilt: 2, speed: 0.8 },
  { fill: 'fill-stripes-butter', tilt: 1, tape: 'stripes', tapeTilt: -2, speed: 1.1 },
  { fill: 'fill-dots-pink', tilt: -1.5, tape: 'dots', tapeTilt: 5, speed: 0.7 },
  { fill: 'fill-stripes-apricot', tilt: 2, tape: 'gingham', tapeTilt: -3, speed: 1.3 },
] as const;
---
<section id="pages" class="gallery wrap">
  <div class="gallery__head">
    <TornLabel color="butter" tilt={2} flip>our pages</TornLabel>
    <h2 class="section-title" data-rise>A peek inside our scrapbooks</h2>
  </div>

  <div class="gallery__grid">
    {club.gallery.map((item, i) => {
      const look = looks[i % looks.length];
      return (
        <div class="gallery__item" data-parallax={look.speed}>
          <Polaroid
            image={item.image}
            caption={item.caption}
            placeholderLabel="project photo"
            fill={look.fill}
            tilt={look.tilt}
            tape={look.tape}
            tapeStyle={`top: -13px; left: 50%; margin-left: -50px; width: 100px; rotate: ${look.tapeTilt}deg;`}
            sizes="(max-width: 720px) 45vw, (max-width: 1100px) 30vw, 380px"
          />
        </div>
      );
    })}
  </div>
</section>

<style>
  .gallery {
    padding-top: 110px;
    padding-bottom: 120px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .gallery__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 48px;
  }
  .gallery__item :global(.polaroid) { padding: 16px 16px 66px; }
  .gallery__item :global(.polaroid__caption) { font-size: 30px; bottom: 16px; }

  @media (max-width: 720px) {
    .gallery { padding-top: 56px; padding-bottom: 64px; gap: 28px; }
    .gallery__head { gap: 16px; }
    .gallery__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 16px; }
    .gallery__item :global(.polaroid) { padding: 8px 8px 38px; }
    .gallery__item :global(.polaroid__caption) { font-size: 19px; bottom: 9px; }
    .gallery__item :global(.polaroid__placeholder) { display: none; }
  }
</style>
