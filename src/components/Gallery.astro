---
import club from '../data/club.json';
import TornLabel from './TornLabel.astro';
import Polaroid from './Polaroid.astro';

const looks = [
  { fill: 'fill-stripes-pink', tilt: -1.5, tape: 'dots', tapeTilt: 3 },
  { fill: 'fill-dots-butter', tilt: 1, tape: 'gingham', tapeTilt: -4 },
  { fill: 'fill-gingham-apricot', tilt: -1, tape: 'dots', tapeTilt: 2 },
  { fill: 'fill-stripes-butter', tilt: 1, tape: 'stripes', tapeTilt: -2 },
  { fill: 'fill-dots-pink', tilt: -1.5, tape: 'dots', tapeTilt: 5 },
  { fill: 'fill-stripes-apricot', tilt: 1.5, tape: 'gingham', tapeTilt: -3 },
] as const;
---
<section id="pages" class="gallery wrap">
  <div class="gallery__head">
    <TornLabel color="butter" tilt={2} flip>our pages</TornLabel>
    <h2 class="section-title" data-rise>A peek inside our scrapbooks</h2>
  </div>

  <div class="gallery__grid">
    {club.gallery.map((item, i) => {
      const look = looks[i % looks.length];
      return (
        <div class="gallery__item">
          <Polaroid
            image={item.image}
            caption={item.caption}
            placeholderLabel="project photo"
            fill={look.fill}
            tilt={look.tilt}
            tape={look.tape}
            tapeStyle={`top: -13px; left: 50%; margin-left: -50px; width: 100px; rotate: ${look.tapeTilt}deg;`}
            sizes="(max-width: 720px) 45vw, 360px"
          />
        </div>
      );
    })}
  </div>
</section>

<style>
  .gallery {
    padding-top: 96px;
    padding-bottom: 104px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .gallery__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  /*
    A plain 3 x 2 grid of same-size polaroids. The grid's width is capped by the
    window height so both rows (plus the heading) fit on one screen.
  */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 36px;
    width: 100%;
    max-width: max(640px, calc((100vh - 420px) * 2 + 72px));
    margin-inline: auto;
  }
  .gallery__item { min-width: 0; }
  .gallery__item :global(.polaroid) { padding: 12px 12px 52px; }
  .gallery__item :global(.polaroid__photo) { aspect-ratio: 4 / 3; }
  /* top-anchored so page titles (like "Making waves") stay in frame */
  .gallery__item :global(.polaroid__photo img) { object-position: 50% 0%; }
  .gallery__item :global(.polaroid__caption) { font-size: 24px; bottom: 14px; }

  @media (max-width: 720px) {
    .gallery { padding-top: 56px; padding-bottom: 64px; gap: 28px; }
    .gallery__head { gap: 16px; }
    .gallery__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 16px; max-width: none; }
    .gallery__item :global(.polaroid) { padding: 8px 8px 10px; }
    /* captions sit in the flow on phones so two-line ones grow the card instead of covering the photo */
    .gallery__item :global(.polaroid__caption) { position: static; margin-top: 8px; font-size: 18px; line-height: 1.05; text-wrap: balance; }
    .gallery__item :global(.polaroid__placeholder) { display: none; }
  }
</style>
