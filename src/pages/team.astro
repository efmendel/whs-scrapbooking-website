---
import { Image } from 'astro:assets';
import MemberCard from '../components/MemberCard.astro';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MotionLayer from '../components/MotionLayer.astro';
import TornLabel from '../components/TornLabel.astro';
import Sticker from '../components/Sticker.astro';
import club from '../data/club.json';
import { findPhoto } from '../lib/photos';

// Card looks cycle so neighbours never match.
const looks = [
  { fill: 'fill-stripes-pink', tape: 'dots', tag: 'var(--butter)', tilt: -2, tapeTilt: 3 },
  { fill: 'fill-dots-butter', tape: 'gingham', tag: 'var(--blush)', tilt: 1.5, tapeTilt: -4 },
  { fill: 'fill-gingham-apricot', tape: 'dots', tag: 'var(--blush)', tilt: -1, tapeTilt: 2 },
  { fill: 'fill-dots-pink', tape: 'stripes', tag: 'var(--butter)', tilt: 2, tapeTilt: -3 },
  { fill: 'fill-stripes-butter', tape: 'gingham', tag: 'var(--blush)', tilt: -1.5, tapeTilt: 4 },
];

// Entries marked "featured" (the co-presidents) get their own row with bigger cards.
const team = club.team.map((m, i) => ({
  ...m,
  featured: 'featured' in m && m.featured === true,
  look: looks[i % looks.length],
}));
const leads = team.filter((m) => m.featured);
const officers = team.filter((m) => !m.featured);
// Officer polaroids per row on wide screens (up to 5; more wrap into balanced rows).
const perRow = officers.length <= 5 ? Math.max(officers.length, 1) : Math.ceil(officers.length / Math.ceil(officers.length / 5));

const advisorPhoto = findPhoto(club.advisor.image);
const advisorEmail = club.advisor.email.startsWith('[') ? undefined : club.advisor.email;
---
<Base
  title={`Meet the team · ${club.clubName}`}
  description={`Meet the students who run the ${club.clubName} at ${club.schoolName}, and our club advisor.`}
>
  <MotionLayer />
  <Nav current="team" />

  <main id="main">
    <section class="team-hero wrap">
      <div class="team-hero__copy">
        <TornLabel color="butter" font="hand" tilt={-3}>meet the team</TornLabel>
        <h1 class="section-title team-hero__title" data-rise>The people behind the pages</h1>
        <p class="team-hero__lede" data-rise>
          Say hi to the students who run the {club.clubName}. You can find us at every meeting in Room
          {' '}{club.meetings.room}.
        </p>
      </div>
      <div class="team-hero__stickers" aria-hidden="true">
        <Sticker kind="heart" rotate={-12} class="ths ths--heart" />
        <Sticker kind="flower" rotate={8} class="ths ths--flower" />
        <Sticker kind="star" rotate={14} class="ths ths--star" />
      </div>
    </section>

    <section class="team wrap" aria-label="Club officers">
      {leads.length > 0 && (
        <ul class="team__leads" role="list">
          {leads.map((m) => (
            <li class="slot slot--lead">
              <MemberCard name={m.name} role={m.role} grade={m.grade} bio={m.bio} image={m.image} look={m.look} featured />
            </li>
          ))}
        </ul>
      )}
      <ul class="team__grid" role="list" style={`--per-row: ${perRow}`}>
        {officers.map((m) => (
          <li class="slot">
            <MemberCard name={m.name} role={m.role} grade={m.grade} bio={m.bio} image={m.image} look={m.look} />
          </li>
        ))}
      </ul>
    </section>

    <section class="advisor wrap" aria-labelledby="advisor-title">
      <div class="advisor__card" data-card>
        <svg class="advisor__clip" width="40" height="106" viewBox="0 0 36 96" aria-hidden="true">
          <path d="M12 30 V78 a10 10 0 0 0 20 0 V14 a12 12 0 0 0 -24 0 V70 a6 6 0 0 0 12 0 V26" fill="none" stroke="var(--rose)" stroke-width="3.5" stroke-linecap="round" />
        </svg>
        <div class:list={['advisor__photo', !advisorPhoto && 'fill-stripes-butter']} data-develop>
          {advisorPhoto ? (
            <Image src={advisorPhoto} alt={`Photo of ${club.advisor.name}`} widths={[240, 360]} sizes="200px" />
          ) : (
            <span class="lbl member__placeholder">photo</span>
          )}
        </div>
        <div class="advisor__text">
          <span class="lbl">Club advisor</span>
          <h2 id="advisor-title" class="display advisor__name">{club.advisor.name}</h2>
          <p class="advisor__body">
            Questions about the club?{' '}
            {advisorEmail ? (
              <a href={`mailto:${advisorEmail}`}>Email {advisorEmail}</a>
            ) : (
              <span>Email {club.advisor.email}</span>
            )}
            {' '}or stop by Room {club.meetings.room}.
          </p>
        </div>
      </div>
    </section>

    <section class="team-cta wrap">
      <TornLabel color="pink" tilt={-2}>want in?</TornLabel>
      <h2 class="section-title" data-rise>Come make pages with us</h2>
      <a href="/#join" class="btn">
        <span>Join the club</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---------- intro ---------- */
  .team-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    align-items: center;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 40px;
  }
  .team-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .team-hero__title { font-size: clamp(44px, 6vw, 84px); line-height: 1; }
  .team-hero__lede { max-width: 560px; font-size: clamp(18px, 1.5vw, 21px); line-height: 1.55; text-wrap: pretty; }
  .team-hero__stickers { position: relative; height: 220px; }
  .team-hero__stickers :global(.ths--heart) { left: 10px; top: 20px; width: 110px; height: auto; }
  .team-hero__stickers :global(.ths--flower) { left: 130px; top: 0; width: 120px; height: auto; }
  .team-hero__stickers :global(.ths--star) { left: 90px; top: 110px; width: 100px; height: auto; }

  /* ---------- officer cards ---------- */
  .team { padding-top: 40px; padding-bottom: 100px; }
  .team__leads,
  .team__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }
  .team__leads { gap: 56px; margin-bottom: 64px; }
  .team__leads > .slot { flex: 0 0 min(280px, calc(50% - 28px)); }
  .team__grid { gap: 48px 30px; max-width: calc(var(--per-row) * 212px + (var(--per-row) - 1) * 30px); margin-inline: auto; }
  .slot { min-width: 0; display: flex; }
  .team__grid > .slot { flex: 0 0 min(212px, calc((100% - (var(--per-row) - 1) * 30px) / var(--per-row))); }
  .member__placeholder { opacity: 0.6; }

  /* ---------- advisor ---------- */
  .advisor { padding-bottom: 110px; display: flex; justify-content: center; }
  .advisor__card {
    position: relative;
    width: min(760px, 100%);
    padding: 36px 40px;
    background-color: var(--card);
    background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 35px, rgb(120 146 180 / 0.22) 35px, rgb(120 146 180 / 0.22) 36px);
    box-shadow: 0 16px 32px -16px rgb(60 40 35 / 0.45);
    rotate: -1deg;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }
  .advisor__clip { position: absolute; top: -34px; left: 48px; }
  .advisor__photo {
    aspect-ratio: 1 / 1;
    padding: 0;
    overflow: hidden;
    box-shadow: 0 0 0 8px var(--card), 0 10px 18px -8px rgb(60 40 35 / 0.35);
    rotate: 3deg;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .advisor__photo img { width: 100%; height: 100%; object-fit: cover; }
  .advisor__text { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .advisor__name { font-size: clamp(30px, 3.4vw, 42px); line-height: 1.05; }
  .advisor__body { font-size: 18px; line-height: 1.55; }
  .advisor__body a { color: var(--rose); text-decoration: underline; text-underline-offset: 3px; }

  /* ---------- call to action ---------- */
  .team-cta {
    padding-bottom: 140px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    text-align: center;
  }

  @media (max-width: 1100px) {
    .team__grid { max-width: 760px; }
    .team__grid > .slot { flex-basis: 212px; }
  }
  @media (max-width: 720px) {
    .team-hero { grid-template-columns: minmax(0, 1fr); padding-top: 28px; padding-bottom: 12px; gap: 0; }
    .team-hero__stickers { height: 110px; }
    .team-hero__stickers :global(.ths--heart) { left: 0; top: 10px; width: 70px; }
    .team-hero__stickers :global(.ths--flower) { left: 80px; top: 0; width: 76px; }
    .team-hero__stickers :global(.ths--star) { left: 160px; top: 20px; width: 64px; }
    .team { padding-top: 28px; padding-bottom: 72px; }
    .team__leads { gap: 16px; margin-bottom: 40px; }
    .team__leads > .slot { flex-basis: calc(50% - 8px); }
    .team__grid { gap: 32px 16px; max-width: none; }
    .team__grid > .slot { flex-basis: calc(50% - 8px); }
    .advisor { padding-bottom: 72px; }
    .advisor__card { grid-template-columns: minmax(0, 1fr); padding: 36px 24px 28px; gap: 20px; rotate: 0.5deg; }
    .advisor__photo { width: 140px; }
    .advisor__clip { left: auto; right: 32px; top: -28px; width: 32px; height: 86px; }
    .advisor__body { font-size: 16px; }
    .team-cta { padding-bottom: 96px; }
  }
</style>
